# 后厨管理系统 - Docker Compose 环境变量模板
#
# 用法：复制为同目录下的 .env，把 4 个 CHANGE_ME 全部改掉。
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
#
# docker-compose.yml 对这 4 个值用了 :? 强制校验，缺失或仍是 CHANGE_ME 时
# `docker compose config` / `up` 会直接报错——这是故意设的安全护栏。
#
# 生成 32+ 位随机串：
#   powershell -Command "[Convert]::ToBase64String((1..36 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])"
#   （Linux: openssl rand -base64 36）
#
# ⚠️ 真实 .env 已被 .gitignore 排除，绝不提交进 git。本模板不含任何真实凭据。
# MYSQL_PASSWORD 同时被 compose 用来拼 KITCHEN_DB_URL（A18 已接线）：
# server 读它连 MySQL 写遥测帧/告警事件，改口令后需 compose up -d 重建 api。
# 口令里若含 @ : / # 等 URL 保留字，需先做 percent-encode，否则 URL 解析会错位。

KITCHEN_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
KITCHEN_API_SECRET=CHANGE_ME_32plus_random_secret
MYSQL_PASSWORD=CHANGE_ME_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_db_root_password
