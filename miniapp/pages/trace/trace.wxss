@import "../../templates/common.wxss";

.qr-box {
  width: 200rpx; height: 200rpx; flex-shrink: 0;
  background: var(--panel-2, #f1ebdd); border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
}
.qr-img { width: 184rpx; height: 184rpx; }
.qr-fallback { text-align: center; line-height: 1.8; }
.qr-fallback:active { opacity: .65; }  /* 失败态可点「重新载图」，给个按压反馈 */

/* ---- 空态引导 ---- */
.intro-card { padding-bottom: 28rpx; }
.demo-head { font-size: 26rpx; font-weight: 600; color: var(--text-2, #6b6355); }
.demo-list { margin-top: 12rpx; }
.demo-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 20rpx; margin-top: 12rpx;
  background: var(--panel-2, #f1ebdd); border-radius: 14rpx;
}
.demo-item:active { opacity: .7; }
.ing-item {
  padding: 16rpx 0; margin-top: 12rpx;
  border-top: 1rpx solid var(--border, #e6dfd0);
}
.ing-item:first-of-type { border-top: none; }
.demo-item .title { font-size: 27rpx; font-weight: 600; letter-spacing: .5rpx; }
.demo-item .caption { margin-top: 4rpx; }
.intro-item { display: flex; align-items: center; gap: 20rpx; padding: 14rpx 0; }
.intro-dot {
  width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700; color: #fff;
}
.intro-dot--blue { background: var(--accent, #1f4d3a); }  /* 类名沿用旧写法，色值已随主题变为墨绿 */
.intro-dot--green { background: var(--green, #2f7d5b); }
.intro-dot--orange { background: var(--orange, #b2680a); }

/* ---- 安全核验 ---- */
.check-row { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; }
.check-row + .check-row { border-top: 1rpx solid var(--line, #e6dfd0); }
.check-icon {
  width: 44rpx; height: 44rpx; flex-shrink: 0; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700;
}
.check-icon--ok { background: rgba(47,125,91,.12); color: var(--green, #2f7d5b); }
.check-icon--warn { background: rgba(178,104,10,.12); color: var(--orange, #b2680a); }
.check-icon--danger { background: rgba(178,58,46,.12); color: var(--red, #b23a2e); }
.check-icon--plain { background: var(--panel-2, #f1ebdd); color: var(--text-3, #988f7f); }
.check-icon--info { background: rgba(63,101,119,.12); color: var(--info, #3f6577); }

/* ---- 保质期进度条 ---- */
.shelf-track {
  height: 16rpx; border-radius: 999rpx; overflow: hidden;
  background: var(--panel-2, #f1ebdd);
}
.shelf-fill { height: 100%; border-radius: 999rpx; transition: width .3s ease; }
.shelf-fill--ok { background: var(--green, #2f7d5b); }
.shelf-fill--warn { background: var(--orange, #b2680a); }
.shelf-fill--danger { background: var(--red, #b23a2e); }

/* ---- 溯源时间线 ---- */
.timeline { display: flex; flex-direction: column; }
.tl-node { display: flex; gap: 20rpx; min-height: 96rpx; }
.tl-rail { width: 28rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; }
.tl-dot {
  width: 24rpx; height: 24rpx; border-radius: 50%; flex-shrink: 0; margin-top: 6rpx;
  box-sizing: border-box; border: 4rpx solid var(--panel, #fffdf8);
  box-shadow: 0 0 0 2rpx currentColor;
}
.tl-dot--ok { color: var(--green, #2f7d5b); background: var(--green, #2f7d5b); }
.tl-dot--warn { color: var(--orange, #b2680a); background: var(--orange, #b2680a); }
.tl-dot--danger { color: var(--red, #b23a2e); background: var(--red, #b23a2e); }
.tl-dot--info { color: var(--info, #3f6577); background: var(--info, #3f6577); }
.tl-dot--plain { color: var(--text-3, #988f7f); background: var(--text-3, #988f7f); }
.tl-line { flex: 1; width: 2rpx; background: var(--line, #e6dfd0); margin: 6rpx 0; }
.tl-body { padding-bottom: 20rpx; }
