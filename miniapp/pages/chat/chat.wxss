.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 0;
}
.chat-tip {
  font-size: 24rpx;
  color: #6e6e73;
  background: #eaf2ff;
  padding: 16rpx 24rpx;
  line-height: 1.6;
}
.chat-list {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.msg-row { display: flex; margin-bottom: 24rpx; }
.msg-row.user { justify-content: flex-end; }
.msg-row.ai { justify-content: flex-start; }
.bubble {
  max-width: 78%;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.bubble.user { background: #0071e3; color: #fff; border-bottom-right-radius: 6rpx; }
.bubble.ai { background: #fff; color: #1d1d1f; border-bottom-left-radius: 6rpx; }
.bubble-text { display: block; }
.bubble-kind, .bubble-ticket {
  display: block;
  font-size: 22rpx;
  margin-top: 10rpx;
  opacity: 0.8;
}
.bubble-ticket { font-weight: 600; }
.typing { color: #8e8e93; }
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx 24rpx;
}
.quick-chip {
  font-size: 24rpx;
  color: #0071e3;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
}
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 32rpx;
  border-top: 1rpx solid #e5e5ea;
}
.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f2f2f7;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.send-btn {
  background: #0071e3;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 36rpx;
}
.send-btn.disabled { opacity: 0.5; }
