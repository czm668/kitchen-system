.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 0;
}
.chat-tip {
  font-size: 24rpx;
  color: var(--text-2, #6b6355);
  background: #eaf2ff;
  padding: 16rpx 24rpx;
  line-height: 1.6;
}
.chat-list {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.msg-row { display: flex; margin-bottom: 24rpx; }
.msg-row.user { justify-content: flex-end; }
.msg-row.ai { justify-content: flex-start; }
.bubble {
  max-width: 78%;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.bubble.user { background: var(--accent, #1f4d3a); color: #fff; border-bottom-right-radius: 6rpx; }
.bubble.ai { background: #fff; color: var(--text, #241f18); border-bottom-left-radius: 6rpx; }
.bubble-text { display: block; }
.bubble-kind, .bubble-ticket {
  display: block;
  font-size: 22rpx;
  margin-top: 10rpx;
  opacity: 0.8;
}
.bubble-ticket { font-weight: 600; }
.typing { color: var(--text-3, #988f7f); }
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx 24rpx;
}
.quick-chip {
  font-size: 24rpx;
  color: var(--accent, #1f4d3a);
  background: var(--panel-2, #f1ebdd);
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
}
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 32rpx;
  border-top: 1rpx solid var(--line, #e6dfd0);
}
.chat-input {
  flex: 1;
  height: 72rpx;
  background: var(--panel-2, #f1ebdd);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.send-btn {
  background: var(--accent, #1f4d3a);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 36rpx;
}
.send-btn.disabled { opacity: 0.5; }
.bubble-handoff {
  display: block;
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--radius-sm, 8rpx);
  font-size: 22rpx;
  line-height: 1.5;
  background: rgba(178, 104, 10, 0.10);
  color: var(--orange, #b2680a);
}
.bubble-handoff.human_now {
  background: rgba(178, 58, 46, 0.10);
  color: var(--red, #b23a2e);
}
