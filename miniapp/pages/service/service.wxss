.tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.tag-pill {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--muted, #6b6355);
  background: var(--panel-2, #f6f2e8);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}
.tag-pill.on {
  color: #fff;
  background: var(--accent, #1f4d3a);
  border-color: var(--accent, #1f4d3a);
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: var(--panel-2, #f6f2e8);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text, #241f18);
}
.input {
  width: 100%;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--panel-2, #f6f2e8);
  font-size: 28rpx;
  color: var(--text, #241f18);
}

.submit-btn {
  margin-top: 24rpx;
  padding: 22rpx 0;
  border-radius: 14rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: var(--accent, #1f4d3a);
}
.submit-btn.disabled { opacity: 0.55; }
.submit-btn.ghost {
  margin-top: 20rpx;
  padding: 16rpx 0;
  font-size: 27rpx;
  color: var(--accent, #1f4d3a);
  background: rgba(31, 77, 58, 0.08);
}

.card--ai {
  border-left: 6rpx solid var(--accent, #1f4d3a);
}

/* 图片证据 */
.img-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 12rpx; }
.img-thumb {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: visible;
}
.img-thumb image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: var(--panel-2, #f6f2e8);
}
.img-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 28rpx;
}
.img-add {
  width: 150rpx;
  height: 150rpx;
  line-height: 150rpx;
  text-align: center;
  border-radius: 12rpx;
  border: 2rpx dashed #c7c7cc;
  color: var(--accent, #1f4d3a);
  font-size: 26rpx;
}

/* 转人工分级：human_now 用警示色（食品安全/法律风险），ai_plus 用琥珀色 */
.handoff-line {
  display: block;
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: var(--radius-sm, 8rpx);
  font-size: 24rpx;
  line-height: 1.5;
  background: rgba(178, 104, 10, 0.10);
  color: var(--orange, #b2680a);
}
.handoff-line.human_now {
  background: rgba(178, 58, 46, 0.10);
  color: var(--red, #b23a2e);
}

/* 结案回访：点星评价 */
.rate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line, rgba(0, 0, 0, 0.06));
}
.rate-stars { display: flex; }
.rate-star {
  font-size: 40rpx;
  line-height: 1;
  padding: 4rpx 8rpx;
  color: var(--orange, #b2680a);
}
