@import "../../templates/common.wxss";

.notify-row {
  display: flex; flex-direction: row; align-items: flex-start;
  padding: 22rpx 0;
}
.notify-row + .notify-row { border-top: 1rpx solid var(--line, #e6dfd0); }
.notify-row:first-child { padding-top: 0; }
.notify-row:last-child { padding-bottom: 0; }
.notify-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--line, #e6dfd0); margin: 14rpx 18rpx 0 0; flex-shrink: 0;
}
.notify-dot.dot--info { background: var(--info, #3f6577); }
