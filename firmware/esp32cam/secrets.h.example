// WiFi 凭据模板（A5-01）
//
// 复制成 secrets.h 再填。`secrets.h` 已在工程 .gitignore 里。
//
// 为什么单独一个文件：草图会进版本库，密码写进草图就等于公开。
// 这不是洁癖——毕业设计的仓库通常会传到 GitHub 给答辩老师看。

#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     "your-ssid"
#define WIFI_PASS     "your-password"

// mDNS 主机名，也是 `device_id`。**必须与数据库 `devices.device_id` 一致**，
// 否则服务端把两路摄像头的数据混成一路（表现为「一会儿有人一会儿没人」）。
#define CAM_HOSTNAME  "esp32cam-01"

#endif  // SECRETS_H
